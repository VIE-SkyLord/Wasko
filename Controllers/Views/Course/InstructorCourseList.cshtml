        function createCourse() {
            // Validate form
            const form = document.getElementById('createCourseForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }
            
            // Collect form data
            const courseData = {
                TenKhoaHoc: document.getElementById('courseName').value,
                IdChuDe: parseInt(document.getElementById('courseTopic').value),
                CapDo: document.getElementById('courseLevel').value,
                GiaKhoaHoc: parseInt(document.getElementById('coursePrice').value),
                MoTa: document.getElementById('courseDescription').value
            };
            
            console.log('Creating course:', courseData);
            // Example API call:
            // fetch('/api/Course', {
