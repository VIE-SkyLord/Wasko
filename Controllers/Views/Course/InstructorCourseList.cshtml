            //     modal.hide();
            //     fetchInstructorCourses();
            // })
            // .catch(error => console.error('Error creating course:', error));
        }
        
        function setupTableActions() {
            // Set up event delegation for table actions
            document.getElementById('courseTableBody').addEventListener('click', function(event) {
                const target = event.target.closest('button, a');
                if (!target) return;
                
                const row = target.closest('tr');
                const courseId = row.dataset.courseId; // Assuming we store courseId in data attribute
                
                if (target.title === 'Xóa') {
                    showDeleteConfirmation(courseId);
                } else if (target.title === 'Gửi duyệt' || target.title === 'Gửi duyệt lại') {
                    showSubmitConfirmation(courseId);
                } else if (target.title === 'Thu hồi') {
                    showRecallConfirmation(courseId);
                } else if (target.title === 'Sao chép') {
                    cloneCourse(courseId);
                } else if (target.title === 'Hủy gửi duyệt') {
                    cancelSubmission(courseId);
                }
            });
        }
        
        function showDeleteConfirmation(courseId) {
            const modal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
            document.getElementById('btnConfirmDelete').onclick = function() {
                deleteCourse(courseId);
                modal.hide();
            };
            modal.show();
        }
        
        function showSubmitConfirmation(courseId) {
            const modal = new bootstrap.Modal(document.getElementById('submitReviewModal'));
            document.getElementById('btnConfirmSubmit').onclick = function() {
                submitForReview(courseId);
                modal.hide();
            };
            modal.show();
        }
        
        function showRecallConfirmation(courseId) {
            const modal = new bootstrap.Modal(document.getElementById('recallCourseModal'));
            document.getElementById('btnConfirmRecall').onclick = function() {
                recallCourse(courseId);
                modal.hide();
            };
            modal.show();
        }
        
