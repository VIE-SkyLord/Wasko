@{
    ViewData["Title"] = "Quản Lý Khóa Học";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Lý Khóa Học</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
                <div class="position-sticky pt-3">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link active" href="#">
                                <i class="fas fa-graduation-cap me-2"></i>
                                Khóa học của tôi
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-users me-2"></i>
                                Học viên
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-chart-line me-2"></i>
                                Thống kê
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-cog me-2"></i>
                                Cài đặt
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Khóa học của tôi</h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCourseModal">
                            <i class="fas fa-plus me-1"></i> Tạo khóa học mới
                        </button>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Tìm kiếm</h5>
                            </div>
                            <div class="card-body">
                                <form class="row g-3">
                                    <div class="col-md-4">
                                        <input type="text" class="form-control" id="searchKeyword" placeholder="Tên khóa học">
                                    </div>
                                    <div class="col-md-3">
                                        <select class="form-select" id="filterStatus">
                                            <option value="">-- Trạng thái --</option>
                                            <option value="Chưa xuất bản">Chưa xuất bản</option>
                                            <option value="Đang chờ duyệt">Đang chờ duyệt</option>
                                            <option value="Đã xuất bản">Đã xuất bản</option>
                                            <option value="Đã thu hồi">Đã thu hồi</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <select class="form-select" id="filterTopic">
                                            <option value="">-- Chủ đề --</option>
                                            <!-- Options will be populated via JavaScript -->
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" class="btn btn-primary w-100" id="btnSearch">
                                            <i class="fas fa-search me-1"></i> Tìm kiếm
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Tên khóa học</th>
                                <th scope="col">Chủ đề</th>
                                <th scope="col">Cấp độ</th>
                                <th scope="col">Trạng thái</th>
                                <th scope="col">Ngày tạo</th>
                                <th scope="col">Giá (VNĐ)</th>
                                <th scope="col">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="courseTableBody">
                            <!-- Example row, will be populated via JavaScript -->
                            <tr>
                                <td>1</td>
                                <td>Lập trình Web với ASP.NET Core</td>
                                <td>Lập trình Web</td>
                                <td>Trung cấp</td>
                                <td><span class="badge bg-warning">Chưa xuất bản</span></td>
                                <td>01/04/2025</td>
                                <td>599,000</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="#" class="btn btn-outline-primary" title="Xem chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="#" class="btn btn-outline-success" title="Chỉnh sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button class="btn btn-outline-info" title="Gửi duyệt">
                                            <i class="fas fa-paper-plane"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" title="Xóa">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>2</td>
                                <td>React và Redux cơ bản</td>
                                <td>Front-end</td>
                                <td>Cơ bản</td>
                                <td><span class="badge bg-success">Đã xuất bản</span></td>
                                <td>15/03/2025</td>
                                <td>499,000</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="#" class="btn btn-outline-primary" title="Xem chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <button class="btn btn-outline-warning" title="Thu hồi">
                                            <i class="fas fa-undo"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary" title="Sao chép">
                                            <i class="fas fa-copy"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>3</td>
                                <td>Node.js và Express</td>
                                <td>Back-end</td>
                                <td>Nâng cao</td>
                                <td><span class="badge bg-info text-dark">Đang chờ duyệt</span></td>
                                <td>25/03/2025</td>
                                <td>699,000</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="#" class="btn btn-outline-primary" title="Xem chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <button class="btn btn-outline-warning" title="Hủy gửi duyệt">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>4</td>
                                <td>Flutter cho người mới bắt đầu</td>
                                <td>Mobile</td>
                                <td>Cơ bản</td>
                                <td><span class="badge bg-secondary">Đã thu hồi</span></td>
                                <td>10/03/2025</td>
                                <td>599,000</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="#" class="btn btn-outline-primary" title="Xem chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="#" class="btn btn-outline-success" title="Chỉnh sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button class="btn btn-outline-info" title="Gửi duyệt lại">
                                            <i class="fas fa-paper-plane"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
