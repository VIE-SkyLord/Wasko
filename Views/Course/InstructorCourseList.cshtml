@model IEnumerable<Wasko.Models.KhoaHoc>
@{
    ViewData["Title"] = "Quản Lý Khóa Học";
}

<div class="container-fluid">
    <div class="row">
        <nav class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
            <div class="position-sticky pt-3">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="Course" asp-action="InstructorCourseList">
                            <i class="fas fa-graduation-cap me-2"></i>
                            Khóa học của tôi
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-users me-2"></i>
                            Học viên
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-chart-line me-2"></i>
                            Thống kê
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-cog me-2"></i>
                            Cài đặt
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Khóa học của tôi</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCourseModal">
                        <i class="fas fa-plus me-1"></i> Tạo khóa học mới
                    </button>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Tìm kiếm</h5>
                        </div>
                        <div class="card-body">
                            <form class="row g-3" id="searchForm">
                                <div class="col-md-4">
                                    <input type="text" class="form-control" id="searchKeyword" placeholder="Tên khóa học">
                                </div>
                                <div class="col-md-3">
                                    <select class="form-select" id="filterStatus">
                                        <option value="">-- Trạng thái --</option>
                                        <option value="Chưa xuất bản">Chưa xuất bản</option>
                                        <option value="Đang chờ duyệt">Đang chờ duyệt</option>
                                        <option value="Đã xuất bản">Đã xuất bản</option>
                                        <option value="Đã thu hồi">Đã thu hồi</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <select class="form-select" id="filterTopic">
                                        <option value="">-- Chủ đề --</option>
                                        @foreach (var topic in ViewBag.Topics)
                                        {
                                            <option value="@topic.Id">@topic.TenChuDe</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <button type="button" class="btn btn-primary w-100" id="btnSearch">
                                        <i class="fas fa-search me-1"></i> Tìm kiếm
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Tên khóa học</th>
                            <th scope="col">Chủ đề</th>
                            <th scope="col">Cấp độ</th>
                            <th scope="col">Trạng thái</th>
                            <th scope="col">Ngày tạo</th>
                            <th scope="col">Giá (VNĐ)</th>
                            <th scope="col">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="courseTableBody">
                        @if (Model != null && Model.Any())
                        {
                            int rowNum = 1;
                            @foreach (var course in Model)
                            {
                                <tr data-course-id="@course.IdKhoaHoc">
                                    <td>@rowNum</td>
                                    <td>@course.TenKhoaHoc</td>
                                    <td>@(course.ChuDe?.TenChuDe ?? "Chưa phân loại")</td>
                                    <td>@course.CapDo</td>
                                    <td>
                                        @switch (course.TrangThai)
                                        {
                                            case "Chưa xuất bản":
                                                <span class="badge bg-warning text-dark">Chưa xuất bản</span>
                                                break;
                                            case "Đang chờ duyệt":
                                                <span class="badge bg-info text-dark">Đang chờ duyệt</span>
                                                break;
                                            case "Đã xuất bản":
                                                <span class="badge bg-success">Đã xuất bản</span>
                                                break;
                                            case "Đã thu hồi":
                                                <span class="badge bg-secondary">Đã thu hồi</span>
                                                break;
                                            default:
                                                <span class="badge bg-light text-dark">@course.TrangThai</span>
                                                break;
                                        }
                                    </td>
                                    <td>@course.NgayTao.ToString("dd/MM/yyyy")</td>
                                    <td>@course.GiaKhoaHoc.ToString("N0")</td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="CourseDetails" asp-route-id="@course.IdKhoaHoc" class="btn btn-outline-primary" title="Xem chi tiết">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            
                                            @if (course.TrangThai == "Chưa xuất bản" || course.TrangThai == "Đã thu hồi")
                                            {
                                                <a asp-action="EditCourse" asp-route-id="@course.IdKhoaHoc" class="btn btn-outline-success" title="Chỉnh sửa">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <button class="btn btn-outline-info btn-submit" data-id="@course.IdKhoaHoc" title="Gửi duyệt">
                                                    <i class="fas fa-paper-plane"></i>
                                                </button>
                                            }
                                            
                                            @if (course.TrangThai == "Chưa xuất bản")
                                            {
                                                <button class="btn btn-outline-danger btn-delete" data-id="@course.IdKhoaHoc" title="Xóa">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                            
                                            @if (course.TrangThai == "Đã xuất bản")
                                            {
                                                <button class="btn btn-outline-warning btn-recall" data-id="@course.IdKhoaHoc" title="Thu hồi">
                                                    <i class="fas fa-undo"></i>
                                                </button>
                                                <button class="btn btn-outline-secondary btn-clone" data-id="@course.IdKhoaHoc" title="Sao chép">
                                                    <i class="fas fa-copy"></i>
                                                </button>
                                            }
                                            
                                            @if (course.TrangThai == "Đang chờ duyệt")
                                            {
                                                <button class="btn btn-outline-warning btn-cancel-submit" data-id="@course.IdKhoaHoc" title="Hủy gửi duyệt">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                rowNum++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4">
                                    <div class="alert alert-info mb-0">
                                        <i class="fas fa-info-circle me-2"></i> Bạn chưa có khóa học nào. Hãy tạo khóa học mới!
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model != null && Model.Count() > 10)
            {
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        <li class="page-item disabled">
                            <a class="page-link" href="#" tabindex="-1" aria-disabled="true">Trước</a>
                        </li>
                        <li class="page-item active"><a class="page-link" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item">
                            <a class="page-link" href="#">Tiếp</a>
                        </li>
                    </ul>
                </nav>
            }
        </main>
    </div>
</div>

<!-- Create Course Modal -->
<div class="modal fade" id="createCourseModal" tabindex="-1" aria-labelledby="createCourseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createCourseModalLabel">Tạo khóa học mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createCourseForm">
                    <div class="mb-3">
                        <label for="courseName" class="form-label">Tên khóa học <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="courseName" required>
                    </div>
                    <div class="mb-3">
                        <label for="courseTopic" class="form-label">Chủ đề <span class="text-danger">*</span></label>
                        <select class="form-select" id="courseTopic" required>
                            <option value="">-- Chọn chủ đề --</option>
                            @foreach (var topic in ViewBag.Topics)
                            {
                                <option value="@topic.Id">@topic.TenChuDe</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="courseLevel" class="form-label">Cấp độ <span class="text-danger">*</span></label>
                        <select class="form-select" id="courseLevel" required>
                            <option value="">-- Chọn cấp độ --</option>
                            <option value="Người mới">Người mới</option>
                            <option value="Cơ bản">Cơ bản</option>
                            <option value="Trung cấp">Trung cấp</option>
                            <option value="Chuyên sâu">Chuyên sâu</option>
                            <option value="Bậc thầy">Bậc thầy</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="coursePrice" class="form-label">Giá khóa học (VNĐ) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="coursePrice" min="0" required>
                    </div>
                    <div class="mb-3">
                        <label for="courseDescription" class="form-label">Mô tả khóa học</label>
                        <textarea class="form-control" id="courseDescription" rows="5"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="btnCreateCourse">Tạo khóa học</button>
            </div>
        </div>
    </div>
</div>

<!-- Confirm Delete Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn xóa khóa học này không? Hành động này không thể hoàn tác.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" id="btnConfirmDelete" data-id="">Xóa</button>
            </div>
        </div>
    </div>
</div>

<!-- Recall Course Modal -->
<div class="modal fade" id="recallModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thu hồi khóa học</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn thu hồi khóa học này không? Khóa học sẽ không còn hiển thị với học viên.</p>
                <div class="mb-3">
                    <label for="recallReason" class="form-label">Lý do thu hồi:</label>
                    <textarea class="form-control" id="recallReason" rows="3" placeholder="Vui lòng nhập lý do thu hồi khóa học"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-warning" id="btnConfirmRecall" data-id="">Thu hồi</button>
            </div>
        </div>
    </div>
</div>

<!-- Submit Course Modal -->
<div class="modal fade" id="submitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Gửi duyệt khóa học</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i> Sau khi gửi duyệt, khóa học sẽ được quản trị viên xem xét và phê duyệt. Trong thời gian này, bạn không thể chỉnh sửa khóa học.
                </div>
                <p>Bạn có chắc chắn muốn gửi khóa học này để xét duyệt không?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="btnConfirmSubmit" data-id="">Gửi duyệt</button>
            </div>
        </div>
    </div>
</div>

<!-- Cancel Submit Modal -->
<div class="modal fade" id="cancelSubmitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Hủy gửi duyệt</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn hủy việc gửi duyệt khóa học này không?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Không</button>
                <button type="button" class="btn btn-warning" id="btnConfirmCancelSubmit" data-id="">Đồng ý</button>
            </div>
        </div>
    </div>
</div>

<!-- Clone Course Modal -->
<div class="modal fade" id="cloneModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Sao chép khóa học</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i> Hệ thống sẽ tạo một bản sao của khóa học này, bao gồm các bài học, tài liệu và bài kiểm tra. Bạn có thể chỉnh sửa bản sao này mà không ảnh hưởng đến khóa học gốc.
                </div>
                <p>Bạn có chắc chắn muốn tạo một bản sao của khóa học này không?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="btnConfirmClone" data-id="">Sao chép</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Search functionality
            $('#btnSearch').click(function () {
                performSearch();
            });
            
            function performSearch() {
                var keyword = $('#searchKeyword').val();
                var status = $('#filterStatus').val();
                var topicId = $('#filterTopic').val();
                
                $.ajax({
                    url: '@Url.Action("GetCourses", "Course")',
                    type: 'GET',
                    data: {
                        keyword: keyword,
                        status: status,
                        topicId: topicId
                    },
                    success: function (data) {
                        updateCourseTable(data);
                    },
                    error: function () {
                        toastr.error('Đã xảy ra lỗi khi tìm kiếm khóa học');
                    }
                });
            }
            
            function updateCourseTable(courses) {
                var tbody = $('#courseTableBody');
                tbody.empty();
                
                if (courses && courses.length > 0) {
                    $.each(courses, function (index, course) {
                        var row = buildCourseRow(index + 1, course);
                        tbody.append(row);
                    });
                } else {
                    tbody.append(`
                        <tr>
                            <td colspan="8" class="text-center py-4">
                                <div class="alert alert-info mb-0">
                                    <i class="fas fa-info-circle me-2"></i> Không tìm thấy khóa học nào phù hợp với điều kiện tìm kiếm.
                                </div>
                            </td>
                        </tr>
                    `);
                }
                
                // Re-attach event handlers
                attachEventHandlers();
            }
            
            function buildCourseRow(rowNum, course) {
                var statusBadge = '';
                switch (course.trangThai) {
                    case 'Chưa xuất bản':
                        statusBadge = '<span class="badge bg-warning text-dark">Chưa xuất bản</span>';
                        break;
                    case 'Đang chờ duyệt':
                        statusBadge = '<span class="badge bg-info text-dark">Đang chờ duyệt</span>';
                        break;
                    case 'Đã xuất bản':
                        statusBadge = '<span class="badge bg-success">Đã xuất bản</span>';
                        break;
                    case 'Đã thu hồi':
                        statusBadge = '<span class="badge bg-secondary">Đã thu hồi</span>';
                        break;
                    default:
                        statusBadge = '<span class="badge bg-light text-dark">' + course.trangThai + '</span>';
                }
                
                var actions = `
                    <div class="btn-group btn-group-sm">
                        <a href="/Course/CourseDetails/${course.idKhoaHoc}" class="btn btn-outline-primary" title="Xem chi tiết">
                            <i class="fas fa-eye"></i>
                        </a>
                `;
                
                if (course.trangThai === 'Chưa xuất bản' || course.trangThai === 'Đã thu hồi') {
                    actions += `
                        <a href="/Course/EditCourse/${course.idKhoaHoc}" class="btn btn-outline-success" title="Chỉnh sửa">
                            <i class="fas fa-edit"></i>
                        </a>
                        <button class="btn btn-outline-info btn-submit" data-id="${course.idKhoaHoc}" title="Gửi duyệt">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    `;
                }
                
                if (course.trangThai === 'Chưa xuất bản') {
                    actions += `
                        <button class="btn btn-outline-danger btn-delete" data-id="${course.idKhoaHoc}" title="Xóa">
                            <i class="fas fa-trash"></i>
                        </button>
                    `;
                }
                
                if (course.trangThai === 'Đã xuất bản') {
                    actions += `
                        <button class="btn btn-outline-warning btn-recall" data-id="${course.idKhoaHoc}" title="Thu hồi">
                            <i class="fas fa-undo"></i>
                        </button>
                        <button class="btn btn-outline-secondary btn-clone" data-id="${course.idKhoaHoc}" title="Sao chép">
                            <i class="fas fa-copy"></i>
                        </button>
                    `;
                }
                
                if (course.trangThai === 'Đang chờ duyệt') {
                    actions += `
                        <button class="btn btn-outline-warning btn-cancel-submit" data-id="${course.idKhoaHoc}" title="Hủy gửi duyệt">
                            <i class="fas fa-times"></i>
                        </button>
                    `;
                }
                
                actions += '</div>';
                
                // Format date
                var createdDate = new Date(course.ngayTao);
                var formattedDate = createdDate.getDate().toString().padStart(2, '0') + '/' + 
                                   (createdDate.getMonth() + 1).toString().padStart(2, '0') + '/' + 
                                   createdDate.getFullYear();
                
                // Format price
                var formattedPrice = course.giaKhoaHoc.toLocaleString('vi-VN');
                
                return `
                    <tr data-course-id="${course.idKhoaHoc}">
                        <td>${rowNum}</td>
                        <td>${course.tenKhoaHoc}</td>
                        <td>${course.chuDe ? course.chuDe.tenChuDe : 'Chưa phân loại'}</td>
                        <td>${course.capDo}</td>
                        <td>${statusBadge}</td>
                        <td>${formattedDate}</td>
                        <td>${formattedPrice}</td>
                        <td>${actions}</td>
                    </tr>
                `;
            }
            
            // Create course
            $('#btnCreateCourse').click(function() {
                var name = $('#courseName').val();
                var topicId = $('#courseTopic').val();
                var level = $('#courseLevel').val();
                var price = $('#coursePrice').val();
                var description = $('#courseDescription').val();
                
                if (!name || !topicId || !level || !price) {
                    toastr.error('Vui lòng điền đầy đủ các trường bắt buộc');
                    return;
                }
                
                $.ajax({
                    url: '@Url.Action("CreateCourse", "Course")',
                    type: 'POST',
                    data: {
                        TenKhoaHoc: name,
                        Id: topicId,
                        CapDo: level,
                        GiaKhoaHoc: price,
                        MoTa: description
                    },
                    success: function(response) {
                        if (response.success) {
                            $('#createCourseModal').modal('hide');
                            toastr.success('Tạo khóa học thành công');
                            setTimeout(function() {
                                window.location.href = '@Url.Action("EditCourse", "Course")/' + response.id;
                            }, 1000);
                        } else {
                            toastr.error('Lỗi: ' + response.message);
                        }
                    },
                    error: function() {
                        toastr.error('Đã xảy ra lỗi khi tạo khóa học');
                    }
                });
            });
            
            // Submit for review
            $(document).on('click', '.btn-submit', function() {
                var courseId = $(this).data('id');
                $('#btnConfirmSubmit').data('id', courseId);
                $('#submitModal').modal('show');
            });
            
            $('#btnConfirmSubmit').click(function() {
                var courseId = $(this).data('id');
                $.ajax({
                    url: '@Url.Action("SubmitForReview", "Course")/' + courseId,
                    type: 'PUT',
                    success: function() {
                        $('#submitModal').modal('hide');
                        toastr.success('Đã gửi khóa học để duyệt');
                        setTimeout(function() {
                            location.reload();
                        }, 1000);
                    },
                    error: function() {
                        toastr.error('Đã xảy ra lỗi khi gửi khóa học để duyệt');
                    }
                });
            });
            
            // Cancel submit
            $(document).on('click', '.btn-cancel-submit', function() {
                var courseId = $(this).data('id');
                $('#btnConfirmCancelSubmit').data('id', courseId);
                $('#cancelSubmitModal').modal('show');
            });
            
            $('#btnConfirmCancelSubmit').click(function() {
                var courseId = $(this).data('id');
                $.ajax({
                    url: '@Url.Action("CancelSubmit", "Course")/' + courseId,
                    type: 'PUT',
                    success: function() {
                        $('#cancelSubmitModal').modal('hide');
                        toastr.success('Đã hủy gửi duyệt');
                        setTimeout(function() {
                            location.reload();
                        }, 1000);
                    },
                    error: function() {
                        toastr.error('Đã xảy ra lỗi khi hủy gửi duyệt');
                    }
                });
            });
            
            // Recall course
            $(document).on('click', '.btn-recall', function() {
                var courseId = $(this).data('id');
                $('#btnConfirmRecall').data('id', courseId);
                $('#recallModal').modal('show');
            });

            $('#btnConfirmRecall').click(function() {
                var courseId = $(this).data('id');
                var reason = $('#recallReason').val();
                
                $.ajax({
                    url: '@Url.Action("RecallCourse", "Course")/' + courseId,
                    type: 'PUT',
                    data: { reason: reason },
                    success: function() {
                        $('#recallModal').modal('hide');
                        toastr.success('Khóa học đã được thu hồi thành công');
                        setTimeout(function() {
                            location.reload();
                        }, 1000);
                    },
                    error: function() {
                        toastr.error('Đã xảy ra lỗi khi thu hồi khóa học');
                    }
                });
            });

            // Delete course
            $(document).on('click', '.btn-delete', function() {
                var courseId = $(this).data('id');
                $('#btnConfirmDelete').data('id', courseId);
                $('#deleteConfirmModal').modal('show');
            });

            $('#btnConfirmDelete').click(function() {
                var courseId = $(this).data('id');
                
                $.ajax({
                    url: '@Url.Action("DeleteCourse", "Course")/' + courseId,
                    type: 'DELETE',
                    success: function() {
                        $('#deleteConfirmModal').modal('hide');
                        toastr.success('Khóa học đã được xóa thành công');
                        setTimeout(function() {
                            location.reload();
                        }, 1000);
                    },
                    error: function(xhr) {
                        $('#deleteConfirmModal').modal('hide');
                        if (xhr.responseText) {
                            toastr.error(xhr.responseText);
                        } else {
                            toastr.error('Đã xảy ra lỗi khi xóa khóa học');
                        }
                    }
                });
            });

            // Clone course
            $(document).on('click', '.btn-clone', function() {
                var courseId = $(this).data('id');
                $('#btnConfirmClone').data('id', courseId);
                $('#cloneModal').modal('show');
            });

            $('#btnConfirmClone').click(function() {
                var courseId = $(this).data('id');
                
                $.ajax({
                    url: '@Url.Action("CloneCourse", "Course")/' + courseId,
                    type: 'POST',
                    success: function(response) {
                        if (response.success) {
                            $('#cloneModal').modal('hide');
                            toastr.success('Khóa học đã được sao chép thành công');
                            setTimeout(function() {
                                window.location.href = '@Url.Action("EditCourse", "Course")/' + response.id;
                            }, 1000);
                        } else {
                            toastr.error('Đã xảy ra lỗi khi sao chép khóa học');
                        }
                    },
                    error: function() {
                        toastr.error('Đã xảy ra lỗi khi sao chép khóa học');
                    }
                });
            });

            // Reset form when modal is closed
            $('#createCourseModal').on('hidden.bs.modal', function() {
                $('#createCourseForm')[0].reset();
            });

            $('#recallModal').on('hidden.bs.modal', function() {
                $('#recallReason').val('');
            });

            // Function to attach event handlers after DOM updates
            function attachEventHandlers() {
                // All event handlers are defined using event delegation
                // So we don't need to do anything here
            }

            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });
        });
    </script>
}