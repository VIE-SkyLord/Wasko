@using System.Security.Claims
@model List<UserRolesViewModel>
@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="container mt-4">
    <h2>Quản lý người dùng và phân quyền</h2>
    
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    <div class="d-flex justify-content-between mb-3">
        <div class="input-group w-50">
            <input type="text" id="searchInput" class="form-control" placeholder="Tìm kiếm người dùng...">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
        </div>
    </div>
    
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Tên người dùng</th>
                    <th>Email</th>
                    <th>Số điện thoại</th>
                    <th>Vai trò hiện tại</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.UserName</td>
                        <td>@user.Email</td>
                        <td>@user.PhoneNumber</td>
                        <td>
                            @if (user.Roles.Any())
                            {
                                @foreach (var role in user.Roles)
                                {
                                    <span class="badge bg-primary me-1">@role</span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-secondary">Chưa có vai trò</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="ManageRoles" asp-route-userId="@user.UserId" class="btn btn-sm btn-primary">
                                    <i class="bi bi-gear"></i> Quản lý vai trò
                                </a>

                                @* Kiểm tra nếu người dùng không phải là quản trị viên và người dùng hiện tại không phải là mình *@
                                @if (user.UserId != User.FindFirstValue(ClaimTypes.NameIdentifier) && User.IsInRole("Quản trị viên"))
                                {
                                    <button type="button" class="btn btn-sm btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-arrow-up-circle"></i> Nâng cấp
                                    </button>
                                    <ul class="dropdown-menu">
                                        @if (user.Roles.Contains("Học viên"))
                                        {
                                            <li>
                                                <form asp-action="PromoteToInstructor" method="post" class="d-inline">
                                                    <input type="hidden" name="userId" value="@user.UserId" />
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item">
                                                        <i class="bi bi-mortarboard"></i> Nâng lên Giảng viên
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                        <li>
                                            <form asp-action="PromoteToModerator" method="post" class="d-inline">
                                                <input type="hidden" name="userId" value="@user.UserId" />
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item">
                                                    <i class="bi bi-shield-check"></i> Thêm vai trò Kiểm duyệt viên
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Hàm tìm kiếm người dùng
        $(document).ready(function(){
            $("#searchInput").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $("tbody tr").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}
